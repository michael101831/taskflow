// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum ConversationKind {
  TEAM
  GROUP
  DIRECT
}

enum ActivityKind {
  TASK_CREATED
  TASK_MOVED
  MEMBER_ADDED
  CHAT_CREATED
}

model User {
  id            String          @id
  email         String          @unique
  displayName   String?
  memberships          ProjectMember[]
  assignedTasks        Task[]               @relation("TaskAssignee")
  messages             Message[]
  conversationMembers  ConversationMember[]
  callRoomsCreated     CallRoom[]           @relation("CallRoomCreator")
  callRoomMembers      CallRoomMember[]
  activity             ActivityEvent[]
  taskComments         TaskComment[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Project {
  id          String          @id @default(cuid())
  name        String
  description String
  tasks         Task[]
  members       ProjectMember[]
  messages      Message[]
  roles         Role[]
  conversations Conversation[]
  callRooms     CallRoom[]
  activity      ActivityEvent[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Role {
  id        String          @id @default(cuid())
  projectId String
  name      String
  isManager Boolean         @default(false)
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members   ProjectMember[]

  @@unique([projectId, name])
}

model ProjectMember {
  projectId  String
  userId     String
  roleId     String
  bookmarked Boolean  @default(false)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  joinedAt   DateTime @default(now())

  @@id([projectId, userId])
  @@index([userId])
  @@index([roleId])
}

model Task {
  id          Int          @id @default(autoincrement())
  title       String
  description String
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime     @db.Date
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    TaskComment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([assigneeId])
}

model CallRoom {
  id          String           @id @default(cuid())
  projectId   String
  name        String?
  directKey   String?
  createdById String
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User             @relation("CallRoomCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members     CallRoomMember[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([projectId, directKey])
  @@index([projectId, updatedAt])
}

model CallRoomMember {
  roomId   String
  userId   String
  room     CallRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@id([roomId, userId])
  @@index([userId])
}

model Conversation {
  id         String               @id @default(cuid())
  projectId  String
  name       String?
  kind       ConversationKind
  directKey  String?
  project    Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members    ConversationMember[]
  messages   Message[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([projectId, directKey])
  @@index([projectId, updatedAt])
}

model ConversationMember {
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  body           String
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([projectId])
  @@index([conversationId, createdAt])
}

model ActivityEvent {
  id        String       @id @default(cuid())
  projectId String
  actorId   String
  kind      ActivityKind
  subject   String
  detail    String?
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor     User         @relation(fields: [actorId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@index([projectId, createdAt])
}

model TaskComment {
  id        String   @id @default(cuid())
  body      String
  taskId    Int
  authorId  String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}
