PORT=3001
DATABASE_URL="postgresql://postgres:password@localhost:5432/taskflow?schema=public"
FIREBASE_PROJECT_ID="your-project-id"
# Comma-separated browser origins allowed to call the API. Omit for local development.
# CLIENT_ORIGIN="https://your-project.web.app"
# Optional. Token checks work with FIREBASE_PROJECT_ID alone.
# Set one of these only if the API must call other Google APIs.
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project-id"}'
# GOOGLE_APPLICATION_CREDENTIALS="path/to/service-account.json"
# For local development only:
# FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
